<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Euconomizo</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#0f172a;color:white;padding-bottom:90px}
header{padding:24px 16px;background:linear-gradient(135deg,#14532d,#172554);border-radius:0 0 28px 28px}
header h1{margin:0;font-size:30px}
header p{margin:6px 0 0;color:#d1fae5;font-size:14px}
.container{padding:15px;max-width:1000px;margin:auto}
.secao{display:none}
.secao.ativa{display:block}
.card{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.14);border-radius:22px;padding:16px;margin-bottom:15px;box-shadow:0 10px 25px rgba(0,0,0,.25)}
.grid3{display:grid;grid-template-columns:1fr;gap:12px}
@media(min-width:750px){.grid3{grid-template-columns:repeat(3,1fr)}}
.valor{font-size:25px;font-weight:bold;margin-top:5px}
.verde{color:#4ade80}.vermelho{color:#fb7185}.azul{color:#60a5fa}.roxo{color:#c084fc}.amarelo{color:#facc15}
input,select,textarea{width:100%;padding:13px;border:0;border-radius:14px;margin:7px 0 12px;font-size:16px}
textarea{min-height:70px;resize:none}
label{font-size:13px;font-weight:bold;color:#e5e7eb}
button{width:100%;padding:13px;border:0;border-radius:15px;background:linear-gradient(135deg,#22c55e,#16a34a);color:white;font-weight:bold;font-size:15px;margin-top:7px}
.btnAzul{background:linear-gradient(135deg,#3b82f6,#2563eb)}
.btnRoxo{background:linear-gradient(135deg,#8b5cf6,#7c3aed)}
.btnVermelho{background:linear-gradient(135deg,#ef4444,#b91c1c)}
.btnCinza{background:#334155}
.item{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.10);border-radius:18px;padding:13px;margin-bottom:10px}
.linha{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.tag{display:inline-block;padding:5px 10px;border-radius:99px;background:rgba(255,255,255,.16);font-size:12px;margin-top:6px}
.pequeno{font-size:13px;color:#cbd5e1;line-height:1.5;margin-top:8px}
.acoes{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.alerta{background:rgba(250,204,21,.16);border-left:5px solid #facc15;padding:12px;border-radius:14px;margin-bottom:10px}
.menu{position:fixed;bottom:0;left:0;right:0;background:#111827;border-top:1px solid rgba(255,255,255,.12);display:grid;grid-template-columns:repeat(5,1fr);z-index:20}
.menu button{background:none;border-radius:0;margin:0;padding:10px 4px;font-size:11px;color:#cbd5e1}
.menu button.ativo{color:#4ade80}
.oculto{display:none}
.barra{height:12px;background:#334155;border-radius:99px;overflow:hidden;margin-top:8px}
.barra span{display:block;height:100%;background:linear-gradient(135deg,#22c55e,#60a5fa);width:0%}
.modalFundo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:50;padding:15px;overflow:auto}
.modalCaixa{max-width:520px;margin:35px auto;background:#111827;border:1px solid rgba(255,255,255,.15);border-radius:24px;padding:18px;box-shadow:0 20px 60px rgba(0,0,0,.45)}
.modalTopo{display:flex;justify-content:space-between;align-items:center;gap:10px}
.modalTopo h3{margin:0}
.fechar{width:auto;background:#334155;padding:8px 12px;border-radius:12px}
</style>
</head>

<body>

<header>
  <h1>Euconomizo</h1>
  <p id="perfilTexto">Controle financeiro do casal</p>
</header>

<div class="container">

<section id="configuracaoInicial" class="card">
  <h3>Configurar casal</h3>

  <label>Seu nome</label>
  <input id="perfilNome" placeholder="Ex: Adriano">

  <label>Você é</label>
  <select id="perfilPapel">
    <option value="Marido">Marido</option>
    <option value="Esposa">Esposa</option>
  </select>

  <label>Sua cor</label>
  <select id="perfilCor">
    <option value="azul">Azul</option>
    <option value="roxo">Roxo</option>
    <option value="verde">Verde</option>
    <option value="rosa">Rosa</option>
  </select>

  <button onclick="criarCasal()">Criar casal</button>

  <hr style="border-color:rgba(255,255,255,.15);margin:18px 0">

  <label>Ou entre com o código do casal</label>
  <input id="codigoCasal" placeholder="Ex: EUCO-1234">
  <button class="btnRoxo" onclick="entrarNoCasal()">Entrar no casal</button>
</section>

<div id="appArea" class="oculto">

<section id="dashboard" class="secao ativa">
  <div class="grid3">
    <div class="card"><div>Entrou</div><div class="valor verde">R$ <span id="totalGanhos">0,00</span></div></div>
    <div class="card"><div>Saiu</div><div class="valor vermelho">R$ <span id="totalGastos">0,00</span></div></div>
    <div class="card"><div>Sobrou</div><div class="valor azul">R$ <span id="saldoFinal">0,00</span></div></div>
  </div>

  <div class="card">
    <h3>Ações rápidas</h3>
    <button onclick="abrirModalLancamento()">+ Novo lançamento</button>
    <button class="btnRoxo" onclick="abrirSecaoPorId('metas')">+ Nova meta</button>
    <button class="btnAzul" onclick="abrirSecaoPorId('relatorios')">Ver relatório</button>
  </div>

  <div class="card">
    <h3>Saúde financeira</h3>
    <div id="saudeFinanceira"></div>
  </div>

  <div class="card">
    <h3>Alertas importantes</h3>
    <div id="alertas"></div>
  </div>

  <div class="card">
    <h3>Metas em andamento</h3>
    <div id="metasDashboard">Nenhuma meta cadastrada ainda.</div>
  </div>

  <div class="card">
    <h3>Últimos lançamentos</h3>
    <div id="ultimosLancamentos"></div>
  </div>
</section>

<section id="lancamentos" class="secao">
  <div class="card">
    <h3>Lançamentos</h3>
    <button onclick="abrirModalLancamento()">+ Novo lançamento</button>
    <p class="pequeno">Use esta área para adicionar ganhos e gastos. O histórico completo fica na aba Histórico.</p>
  </div>
</section>

<section id="fixos" class="secao">
  <div class="card">
    <h3>Gasto fixo</h3>
    <label>Nome</label>
    <input id="fixoNome" placeholder="Ex: Aluguel, Internet">
    <label>Valor</label>
    <input id="fixoValor" type="number" step="0.01">
    <label>Categoria</label>
    <select id="fixoCategoria"></select>
    <label>Dia de vencimento</label>
    <input id="fixoDia" type="number" min="1" max="31" placeholder="Ex: 10">
    <button onclick="salvarFixo()">Salvar gasto fixo</button>
  </div>
  <div class="card"><h3>Fixos cadastrados</h3><div id="listaFixos"></div></div>
</section>

<section id="parcelados" class="secao">
  <div class="card">
    <h3>Compra parcelada</h3>
    <label>Nome</label>
    <input id="parcelaNome" placeholder="Ex: Geladeira, Celular">
    <label>Valor da parcela</label>
    <input id="parcelaValor" type="number" step="0.01">
    <label>Total de parcelas</label>
    <input id="parcelaTotal" type="number" min="1">
    <label>Parcelas já pagas</label>
    <input id="parcelaPagas" type="number" min="0" value="0">
    <label>Categoria</label>
    <select id="parcelaCategoria"></select>
    <label>Próximo pagamento</label>
    <input id="parcelaData" type="date">
    <button onclick="salvarParcelado()">Salvar compra parcelada</button>
  </div>
  <div class="card"><h3>Compras parceladas</h3><div id="listaParcelados"></div></div>
</section>

<section id="metas" class="secao">
  <div class="card">
    <h3>Nova meta do casal</h3>
    <label>Nome da meta</label>
    <input id="metaNome" placeholder="Ex: Viagem, Reserva de emergência">
    <label>Valor alvo</label>
    <input id="metaAlvo" type="number" step="0.01">
    <label>Valor atual</label>
    <input id="metaAtual" type="number" step="0.01" value="0">
    <label>Prazo</label>
    <input id="metaPrazo" type="date">
    <button onclick="salvarMeta()">Salvar meta</button>
  </div>
  <div class="card"><h3>Metas cadastradas</h3><div id="listaMetas"></div></div>
</section>

<section id="relatorios" class="secao">
  <div class="card"><h3>Relatório do casal</h3><div id="relatorioCasal"></div></div>
  <div class="card"><h3>Gráfico por categoria</h3><canvas id="graficoCategorias"></canvas></div>
  <div class="card"><h3>Resumo por categoria</h3><div id="resumoCategorias"></div></div>
</section>

<section id="historicoSecao" class="secao">
  <div class="card"><h3>Histórico completo</h3><div id="historico">Carregando...</div></div>
</section>

<section id="config" class="secao">
  <div class="card">
    <h3>Configurações do casal</h3>
    <p id="infoCasal"></p>
    <button class="btnCinza" onclick="copiarCodigo()">Copiar código do casal</button>
  </div>
</section>

</div>
</div>

<div id="modalLancamento" class="modalFundo">
  <div class="modalCaixa">
    <div class="modalTopo">
      <h3 id="tituloModal">Novo lançamento</h3>
      <button class="fechar" onclick="fecharModalLancamento()">X</button>
    </div>

    <input type="hidden" id="editandoId">

    <label>Tipo</label>
    <select id="tipo" onchange="atualizarCategorias()">
      <option value="ganho">Ganho</option>
      <option value="gasto">Gasto</option>
    </select>

    <label>Nome</label>
    <input id="nome" placeholder="Ex: Salário, Mercado, Aluguel">

    <label>Valor</label>
    <input id="valor" type="number" step="0.01" placeholder="Ex: 120.50">

    <label>Categoria</label>
    <select id="categoria"></select>

    <label>Data</label>
    <input id="data" type="date">

    <label>Observação</label>
    <textarea id="observacao" placeholder="Ex: compra da semana, renda extra..."></textarea>

    <button onclick="salvarLancamento()" id="btnSalvar">Salvar lançamento</button>
    <button class="btnCinza" onclick="limparFormulario()">Limpar</button>
  </div>
</div>

<nav class="menu oculto" id="menuApp">
  <button class="ativo" onclick="abrirSecao('dashboard',this)">🏠<br>Início</button>
  <button onclick="abrirSecao('lancamentos',this)">➕<br>Lançar</button>
  <button onclick="abrirSecao('fixos',this)">📌<br>Fixos</button>
  <button onclick="abrirSecao('metas',this)">🎯<br>Metas</button>
  <button onclick="abrirSecao('relatorios',this)">📊<br>Mais</button>
</nav>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-app.js";
import { getAuth,onAuthStateChanged } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-auth.js";
import { getFirestore,collection,addDoc,getDocs,updateDoc,deleteDoc,doc,setDoc,getDoc,query,where,serverTimestamp } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-firestore.js";

const firebaseConfig={
  apiKey:"AIzaSyCElTa77Q7PiEgsMadbxDxZvxC-QE1P-ks",
  authDomain:"euconomizo-ebc13.firebaseapp.com",
  projectId:"euconomizo-ebc13",
  storageBucket:"euconomizo-ebc13.firebasestorage.app",
  messagingSenderId:"184248751974",
  appId:"1:184248751974:web:43edb4192a766a2a019aa7"
};

const app=initializeApp(firebaseConfig);
const auth=getAuth(app);
const db=getFirestore(app);

let usuarioAtual=null,perfil=null,grafico=null,lancamentosCache=[];

const categoriasGanhos=["Salário","Renda extra","Venda","Presente","Reembolso","Investimentos","Outros"];
const categoriasGastos=["Alimentação","Moradia","Contas","Transporte","Saúde","Lazer","Compras","Educação","Igreja/doações","Dívidas","Cartão de crédito","Parcelado","Outros"];
const cores={azul:"#60a5fa",roxo:"#c084fc",verde:"#4ade80",rosa:"#f472b6"};

window.abrirSecao=function(id,botao){
  document.querySelectorAll(".secao").forEach(s=>s.classList.remove("ativa"));
  document.getElementById(id).classList.add("ativa");
  document.querySelectorAll(".menu button").forEach(b=>b.classList.remove("ativo"));
  botao.classList.add("ativo");
};

window.abrirSecaoPorId=function(id){
  document.querySelectorAll(".secao").forEach(s=>s.classList.remove("ativa"));
  document.getElementById(id).classList.add("ativa");
};

window.abrirModalLancamento=function(){
  document.getElementById("modalLancamento").style.display="block";
};

window.fecharModalLancamento=function(){
  document.getElementById("modalLancamento").style.display="none";
};

function moeda(v){return Number(v||0).toLocaleString("pt-BR",{minimumFractionDigits:2,maximumFractionDigits:2})}
function hoje(){return new Date().toISOString().split("T")[0]}
function codigo(){return "EUCO-"+Math.floor(1000+Math.random()*9000)}
function preencher(id,lista){const s=document.getElementById(id);s.innerHTML="";lista.forEach(i=>{const o=document.createElement("option");o.value=i;o.textContent=i;s.appendChild(o)})}

function mostrarApp(){
  document.getElementById("configuracaoInicial").classList.add("oculto");
  document.getElementById("appArea").classList.remove("oculto");
  document.getElementById("menuApp").classList.remove("oculto");
  document.getElementById("perfilTexto").innerHTML=`Casal: <b>${perfil.codigoCasal}</b> • <span style="color:${cores[perfil.cor]}">${perfil.nome}</span> (${perfil.papel})`;
  document.getElementById("infoCasal").innerHTML=`Código do casal: <b>${perfil.codigoCasal}</b><br>Nome: ${perfil.nome}<br>Perfil: ${perfil.papel}`;
  atualizarCategorias();
  preencher("fixoCategoria",categoriasGastos);
  preencher("parcelaCategoria",categoriasGastos);
  document.getElementById("data").value=hoje();
  document.getElementById("parcelaData").value=hoje();
  document.getElementById("metaPrazo").value=hoje();
  carregarTudo();
}

async function salvarPerfil(){await setDoc(doc(db,"usuarios",usuarioAtual.uid),perfil,{merge:true});localStorage.setItem("perfilEuconomizo",JSON.stringify(perfil))}

window.criarCasal=async function(){
  const nome=document.getElementById("perfilNome").value.trim(),papel=document.getElementById("perfilPapel").value,cor=document.getElementById("perfilCor").value;
  if(!nome)return alert("Digite seu nome.");
  const cod=codigo();
  const casal=await addDoc(collection(db,"casais"),{codigo:cod,criadoPor:usuarioAtual.uid,criadoEm:serverTimestamp()});
  perfil={uid:usuarioAtual.uid,email:usuarioAtual.email,nome,papel,cor,casalId:casal.id,codigoCasal:cod};
  await salvarPerfil();
  alert("Casal criado! Código: "+cod);
  mostrarApp();
};

window.entrarNoCasal=async function(){
  const nome=document.getElementById("perfilNome").value.trim(),papel=document.getElementById("perfilPapel").value,cor=document.getElementById("perfilCor").value,cod=document.getElementById("codigoCasal").value.trim().toUpperCase();
  if(!nome)return alert("Digite seu nome.");
  if(!cod)return alert("Digite o código.");
  const snap=await getDocs(query(collection(db,"casais"),where("codigo","==",cod)));
  if(snap.empty)return alert("Código não encontrado.");
  perfil={uid:usuarioAtual.uid,email:usuarioAtual.email,nome,papel,cor,casalId:snap.docs[0].id,codigoCasal:cod};
  await salvarPerfil();
  alert("Você entrou no casal!");
  mostrarApp();
};

window.atualizarCategorias=function(){preencher("categoria",document.getElementById("tipo").value==="ganho"?categoriasGanhos:categoriasGastos)};

window.limparFormulario=function(){
  document.getElementById("editandoId").value="";
  document.getElementById("tipo").value="ganho";
  document.getElementById("nome").value="";
  document.getElementById("valor").value="";
  document.getElementById("observacao").value="";
  document.getElementById("data").value=hoje();
  document.getElementById("btnSalvar").innerText="Salvar lançamento";
  document.getElementById("tituloModal").innerText="Novo lançamento";
  atualizarCategorias();
};

window.salvarLancamento=async function(){
  const id=document.getElementById("editandoId").value,tipo=document.getElementById("tipo").value,nome=document.getElementById("nome").value.trim(),valor=parseFloat(document.getElementById("valor").value),categoria=document.getElementById("categoria").value,data=document.getElementById("data").value,observacao=document.getElementById("observacao").value.trim();
  if(!nome)return alert("Digite o nome.");
  if(!valor||valor<=0)return alert("Digite um valor válido.");
  const dados={casalId:perfil.casalId,tipo,nome,valor,categoria,data,observacao,usuarioId:usuarioAtual.uid,usuarioEmail:usuarioAtual.email,usuarioNome:perfil.nome,usuarioPapel:perfil.papel,usuarioCor:perfil.cor,atualizadoEm:serverTimestamp()};
  if(id){await updateDoc(doc(db,"lancamentos",id),dados);alert("Atualizado!")}else{dados.criadoEm=serverTimestamp();await addDoc(collection(db,"lancamentos"),dados);alert("Salvo!")}
  limparFormulario();
  fecharModalLancamento();
  carregarTudo();
};

window.editarLancamento=function(id,texto){
  const i=JSON.parse(decodeURIComponent(texto));
  document.getElementById("editandoId").value=id;
  document.getElementById("tipo").value=i.tipo;
  atualizarCategorias();
  document.getElementById("nome").value=i.nome;
  document.getElementById("valor").value=i.valor;
  document.getElementById("categoria").value=i.categoria;
  document.getElementById("data").value=i.data;
  document.getElementById("observacao").value=i.observacao||"";
  document.getElementById("btnSalvar").innerText="Salvar alteração";
  document.getElementById("tituloModal").innerText="Editar lançamento";
  abrirModalLancamento();
};

window.excluirLancamento=async function(id){if(confirm("Excluir este lançamento?")){await deleteDoc(doc(db,"lancamentos",id));carregarTudo()}};

window.salvarFixo=async function(){
  const nome=document.getElementById("fixoNome").value.trim(),valor=parseFloat(document.getElementById("fixoValor").value),categoria=document.getElementById("fixoCategoria").value,dia=parseInt(document.getElementById("fixoDia").value);
  if(!nome||!valor||!dia)return alert("Preencha os dados do fixo.");
  await addDoc(collection(db,"gastosFixos"),{casalId:perfil.casalId,nome,valor,categoria,dia,ativo:true,criadoPor:perfil.nome,criadoEm:serverTimestamp()});
  document.getElementById("fixoNome").value="";document.getElementById("fixoValor").value="";document.getElementById("fixoDia").value="";
  carregarTudo();
};

window.lancarFixo=async function(nome,valor,categoria){
  await addDoc(collection(db,"lancamentos"),{casalId:perfil.casalId,tipo:"gasto",nome,valor:Number(valor),categoria,data:hoje(),observacao:"Lançado a partir de gasto fixo",usuarioId:usuarioAtual.uid,usuarioEmail:usuarioAtual.email,usuarioNome:perfil.nome,usuarioPapel:perfil.papel,usuarioCor:perfil.cor,criadoEm:serverTimestamp()});
  carregarTudo();
};

window.excluirFixo=async function(id){if(confirm("Excluir fixo?")){await deleteDoc(doc(db,"gastosFixos",id));carregarTudo()}};

window.salvarParcelado=async function(){
  const nome=document.getElementById("parcelaNome").value.trim(),valor=parseFloat(document.getElementById("parcelaValor").value),total=parseInt(document.getElementById("parcelaTotal").value),pagas=parseInt(document.getElementById("parcelaPagas").value||0),categoria=document.getElementById("parcelaCategoria").value,data=document.getElementById("parcelaData").value;
  if(!nome||!valor||!total)return alert("Preencha os dados do parcelado.");
  await addDoc(collection(db,"parcelados"),{casalId:perfil.casalId,nome,valorParcela:valor,parcelasTotal:total,parcelasPagas:pagas,categoria,proximoPagamento:data,criadoPor:perfil.nome,criadoEm:serverTimestamp()});
  document.getElementById("parcelaNome").value="";document.getElementById("parcelaValor").value="";document.getElementById("parcelaTotal").value="";document.getElementById("parcelaPagas").value=0;
  carregarTudo();
};

window.pagarParcela=async function(id,texto){
  const i=JSON.parse(decodeURIComponent(texto));
  if(i.parcelasPagas>=i.parcelasTotal)return alert("Já quitada.");
  const nova=i.parcelasPagas+1;
  await updateDoc(doc(db,"parcelados",id),{parcelasPagas:nova});
  await addDoc(collection(db,"lancamentos"),{casalId:perfil.casalId,tipo:"gasto",nome:`${i.nome} - parcela ${nova}/${i.parcelasTotal}`,valor:Number(i.valorParcela),categoria:i.categoria,data:hoje(),observacao:"Parcela paga",usuarioId:usuarioAtual.uid,usuarioEmail:usuarioAtual.email,usuarioNome:perfil.nome,usuarioPapel:perfil.papel,usuarioCor:perfil.cor,criadoEm:serverTimestamp()});
  carregarTudo();
};

window.excluirParcelado=async function(id){if(confirm("Excluir parcelado?")){await deleteDoc(doc(db,"parcelados",id));carregarTudo()}};

window.salvarMeta=async function(){
  const nome=document.getElementById("metaNome").value.trim(),alvo=parseFloat(document.getElementById("metaAlvo").value),atual=parseFloat(document.getElementById("metaAtual").value||0),prazo=document.getElementById("metaPrazo").value;
  if(!nome||!alvo)return alert("Preencha a meta.");
  await addDoc(collection(db,"metas"),{casalId:perfil.casalId,nome,valorAlvo:alvo,valorAtual:atual,prazo,criadoPor:perfil.nome,criadoEm:serverTimestamp()});
  document.getElementById("metaNome").value="";document.getElementById("metaAlvo").value="";document.getElementById("metaAtual").value=0;
  carregarTudo();
};

window.excluirMeta=async function(id){if(confirm("Excluir meta?")){await deleteDoc(doc(db,"metas",id));carregarTudo()}};
window.copiarCodigo=function(){navigator.clipboard.writeText(perfil.codigoCasal);alert("Código copiado: "+perfil.codigoCasal)};

async function carregarTudo(){await carregarLancamentos();await carregarFixos();await carregarParcelados();await carregarMetas()}

async function carregarLancamentos(){
  let ganhos=0,gastos=0,categorias={},graf={},porPessoa={};
  const snap=await getDocs(query(collection(db,"lancamentos"),where("casalId","==",perfil.casalId)));
  lancamentosCache=[];snap.forEach(d=>lancamentosCache.push({id:d.id,...d.data()}));
  lancamentosCache.sort((a,b)=>String(b.data).localeCompare(String(a.data)));

  const hist=document.getElementById("historico"),ult=document.getElementById("ultimosLancamentos");
  hist.innerHTML="";ult.innerHTML="";

  lancamentosCache.forEach((i,idx)=>{
    if(i.tipo==="ganho")ganhos+=Number(i.valor);else gastos+=Number(i.valor);
    categorias[i.categoria]=(categorias[i.categoria]||0)+Number(i.valor);
    if(i.tipo==="gasto")graf[i.categoria]=(graf[i.categoria]||0)+Number(i.valor);

    const p=i.usuarioPapel||i.usuarioNome||"Pessoa";
    if(!porPessoa[p])porPessoa[p]={ganhos:0,gastos:0};
    if(i.tipo==="ganho")porPessoa[p].ganhos+=Number(i.valor);else porPessoa[p].gastos+=Number(i.valor);

    const cor=cores[i.usuarioCor]||"#4ade80",classe=i.tipo==="ganho"?"verde":"vermelho",sinal=i.tipo==="ganho"?"+":"-";
    const seguro=encodeURIComponent(JSON.stringify({tipo:i.tipo,nome:i.nome,valor:i.valor,categoria:i.categoria,data:i.data,observacao:i.observacao||""}));

    const html=`
      <div class="item">
        <div class="linha">
          <div>
            <b>${i.nome}</b><br>
            <span class="tag">${i.categoria}</span>
          </div>
          <div class="${classe}">
            <b>${sinal} R$ ${moeda(i.valor)}</b>
          </div>
        </div>
        <div class="pequeno">
          Data: ${i.data||"sem data"}<br>
          Por: <span style="color:${cor};font-weight:bold">${i.usuarioNome||"Usuário"} (${i.usuarioPapel||""})</span><br>
          ${i.observacao?"Obs: "+i.observacao:""}
        </div>
        <div class="acoes">
          <button class="btnAzul" onclick="editarLancamento('${i.id}','${seguro}')">Editar</button>
          <button class="btnVermelho" onclick="excluirLancamento('${i.id}')">Excluir</button>
        </div>
      </div>
    `;

    hist.innerHTML+=html;
    if(idx<5)ult.innerHTML+=html;
  });

  if(!hist.innerHTML)hist.innerHTML="Nenhum lançamento ainda.";
  if(!ult.innerHTML)ult.innerHTML="Nenhum lançamento ainda.";

  document.getElementById("totalGanhos").textContent=moeda(ganhos);
  document.getElementById("totalGastos").textContent=moeda(gastos);
  document.getElementById("saldoFinal").textContent=moeda(ganhos-gastos);

  const saldo=ganhos-gastos;
  if(saldo>0){
    document.getElementById("saudeFinanceira").innerHTML=`<div class="alerta">Boa ✅ Vocês estão gastando menos do que entrou. Sobrou R$ ${moeda(saldo)}.</div>`;
  }else if(saldo===0){
    document.getElementById("saudeFinanceira").innerHTML=`<div class="alerta">Atenção ⚠️ Entrou e saiu praticamente o mesmo valor. Tentem guardar um pouco.</div>`;
  }else{
    document.getElementById("saudeFinanceira").innerHTML=`<div class="alerta">Risco 🚨 Vocês gastaram R$ ${moeda(Math.abs(saldo))} a mais do que entrou.</div>`;
  }

  const alertas=document.getElementById("alertas");
  alertas.innerHTML="";
  if(gastos>ganhos)alertas.innerHTML+=`<div class="alerta">Os gastos estão maiores que os ganhos.</div>`;
  if(ganhos>0 && (graf["Alimentação"]||0)>ganhos*.35)alertas.innerHTML+=`<div class="alerta">O gasto com alimentação passou do normal.</div>`;
  if(ganhos>0 && (graf["Lazer"]||0)>ganhos*.25)alertas.innerHTML+=`<div class="alerta">O gasto com lazer está alto este mês.</div>`;
  if(!alertas.innerHTML)alertas.innerHTML=`<div class="alerta">Vocês estão indo bem. Continuem registrando tudo.</div>`;

  const resumo=document.getElementById("resumoCategorias");
  resumo.innerHTML="";
  Object.keys(categorias).forEach(c=>{
    resumo.innerHTML+=`<div class="linha" style="padding:8px 0;border-bottom:1px solid rgba(255,255,255,.1)"><span>${c}</span><b>R$ ${moeda(categorias[c])}</b></div>`;
  });
  if(!resumo.innerHTML)resumo.innerHTML="Sem dados.";

  const rel=document.getElementById("relatorioCasal");
  rel.innerHTML=`<p><b>Total do casal:</b><br>Entrou R$ ${moeda(ganhos)}<br>Saiu R$ ${moeda(gastos)}<br>Sobrou R$ ${moeda(saldo)}</p>`;
  Object.keys(porPessoa).forEach(p=>{
    rel.innerHTML+=`<div class="item"><b>${p}</b><br>Ganhos: R$ ${moeda(porPessoa[p].ganhos)}<br>Gastos: R$ ${moeda(porPessoa[p].gastos)}<br>Saldo: R$ ${moeda(porPessoa[p].ganhos-porPessoa[p].gastos)}</div>`;
  });

  montarGrafico(graf);
}

async function carregarFixos(){
  const lista=document.getElementById("listaFixos");
  lista.innerHTML="";
  const snap=await getDocs(query(collection(db,"gastosFixos"),where("casalId","==",perfil.casalId)));
  snap.forEach(d=>{
    const i=d.data();
    lista.innerHTML+=`<div class="item"><b>${i.nome}</b><br><span class="tag">${i.categoria}</span><div class="pequeno">R$ ${moeda(i.valor)} • vence dia ${i.dia}</div><button onclick="lancarFixo('${i.nome}',${i.valor},'${i.categoria}')">Lançar este mês</button><button class="btnVermelho" onclick="excluirFixo('${d.id}')">Excluir</button></div>`;
  });
  if(!lista.innerHTML)lista.innerHTML="Nenhum gasto fixo.";
}

async function carregarParcelados(){
  const lista=document.getElementById("listaParcelados");
  lista.innerHTML="";
  const snap=await getDocs(query(collection(db,"parcelados"),where("casalId","==",perfil.casalId)));
  snap.forEach(d=>{
    const i=d.data(),faltam=i.parcelasTotal-i.parcelasPagas,seg=encodeURIComponent(JSON.stringify({nome:i.nome,valorParcela:i.valorParcela,parcelasTotal:i.parcelasTotal,parcelasPagas:i.parcelasPagas,categoria:i.categoria}));
    lista.innerHTML+=`<div class="item"><b>${i.nome}</b><br><span class="tag">${i.categoria}</span><div class="pequeno">Parcela: R$ ${moeda(i.valorParcela)}<br>Pagas: ${i.parcelasPagas}/${i.parcelasTotal}<br>Faltam: ${faltam}<br>Próximo: ${i.proximoPagamento||"não informado"}</div><button class="btnRoxo" onclick="pagarParcela('${d.id}','${seg}')">Registrar próxima parcela</button><button class="btnVermelho" onclick="excluirParcelado('${d.id}')">Excluir</button></div>`;
  });
  if(!lista.innerHTML)lista.innerHTML="Nenhuma compra parcelada.";
}

async function carregarMetas(){
  const lista=document.getElementById("listaMetas"),dash=document.getElementById("metasDashboard");
  lista.innerHTML="";
  dash.innerHTML="";
  const snap=await getDocs(query(collection(db,"metas"),where("casalId","==",perfil.casalId)));
  snap.forEach(d=>{
    const i=d.data(),pct=Math.min(100,((Number(i.valorAtual)||0)/(Number(i.valorAlvo)||1))*100),faltam=Number(i.valorAlvo)-Number(i.valorAtual);
    const html=`<div class="item"><b>${i.nome}</b><div class="pequeno">R$ ${moeda(i.valorAtual)} de R$ ${moeda(i.valorAlvo)}<br>Faltam R$ ${moeda(faltam)} • Prazo: ${i.prazo||"sem prazo"}</div><div class="barra"><span style="width:${pct}%"></span></div><button class="btnVermelho" onclick="excluirMeta('${d.id}')">Excluir meta</button></div>`;
    lista.innerHTML+=html;
    dash.innerHTML+=html;
  });
  if(!lista.innerHTML)lista.innerHTML="Nenhuma meta cadastrada.";
  if(!dash.innerHTML)dash.innerHTML="Nenhuma meta em andamento.";
}

function montarGrafico(dados){
  const ctx=document.getElementById("graficoCategorias");
  if(grafico)grafico.destroy();
  grafico=new Chart(ctx,{type:"doughnut",data:{labels:Object.keys(dados),datasets:[{data:Object.values(dados)}]},options:{plugins:{legend:{labels:{color:"#fff"}}}}});
}

onAuthStateChanged(auth,async user=>{
  if(!user){window.location.href="index.html";return}
  usuarioAtual=user;
  const userDoc=await getDoc(doc(db,"usuarios",user.uid));
  const local=JSON.parse(localStorage.getItem("perfilEuconomizo"));
  if(userDoc.exists())perfil=userDoc.data();else if(local&&local.casalId){perfil=local;await salvarPerfil()}
  if(perfil&&perfil.casalId)mostrarApp();else{
    document.getElementById("perfilNome").value=local?.nome||"";
    document.getElementById("perfilPapel").value=local?.papel||"Marido";
    document.getElementById("perfilCor").value=local?.cor||"azul";
  }
});
</script>
